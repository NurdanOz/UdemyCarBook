<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="col-lg-4">
    <div class="card">
        <div class="card-body">

            <h4 class="card-title d-inline-block">Yıllık Kiralama Sayıları</h4>

            <div style="height: 260px; position: relative;">
                <canvas id="my1Chart"></canvas>
                <script>
                    
                    document.addEventListener("DOMContentLoaded", function() {
                        var values = document.getElementById('my1Chart').getContext('2d');
                        var myChart = new Chart(values, {
                            type: 'line',
                            data: {
                                labels: ['2021', '2022', '2023', '2024', '2025'], 
                                datasets: [{
                                    label: 'Yıllık Kiralama Grafiği',
                                    data: [285, 245, 185, 366, 458],
                                    borderColor: 'rgba(75,192,192,1)',
                                    backgroundColor: 'rgba(75,192,192,0.2)',
                                    borderWidth: 2
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                scales: {
                                    y: {
                                        beginAtZero: true
                                    }
                                }
                            }
                        });
                    });
                </script>
            </div>

            <div class="row text-center mt-4">
                <div class="col-6">
                    <h4>₺ 367.850</h4>
                    <p class="text-muted mb-0">Son 1 Aylık Ciro</p>
                </div>
                <div class="col-6">
                    <h4>₺ 7850</h4>
                    <p class="text-muted mb-0">Bugünkü Kazanç</p>
                </div>
            </div>
        </div>
    </div>
</div>