@model List<ResultAllBlogsWithAuthorDto>

<div class="col-xl-6">
    <div class="card" style="min-height: 420px;">
        <div class="card-body">

            <h4 class="card-title">Son Bloglar</h4>
            <p class="card-subtitle mb-4 font-size-13">
                Sistemdeki en son paylaşılan blogların listesi.
            </p>

            <div class="table-responsive">
                <table class="table table-borderless table-hover table-centered mb-0" style="table-layout: fixed; width: 100%;">
                    <thead>
                        <tr>
                            <th style="width: 50%;">Blog Başlığı</th>
                           
                            <th style="width: 20%; text-align: center;">Bloğu Aç</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Take(5)) 
                        {
                            <tr>
                                <td class="text-truncate" style="max-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    <h5 class="font-size-14 mb-1 font-weight-normal" title="@item.Title">@item.Title</h5>
                                </td>
                             
                                <td style="text-align: center;">
                                    <a href="/Blog/BlogDetail/@item.BlogID" class="btn btn-sm btn-primary">Bloğu Aç</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div> ```
